# WaypointFlow Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/waypointflow

# JWT Authentication (MANDATORY: replace with a high-entropy secret string)
JWT_SECRET=replace_with_a_secure_jwt_secret_key_for_production
JWT_EXPIRES_IN=24h

# Competition Datasets Root Path (Optional override)
DATA_PATH=../data

# Supabase Storage (Optional - for POD image upload if enabled)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=uploads
